# Kindle Dashboard Configuration

# Weather location (Praha)
WEATHER_LAT=50.0755
WEATHER_LON=14.4378

# Radicale CalDAV server
RADICALE_URL=http://radicale:5232/user/
RADICALE_USER=user
RADICALE_PASS=password

# Radicale calendar filtering (comma-separated calendar names, empty = all)
WATCHED_CALENDARS=Osobní,Práce
WATCHED_TASK_CALENDARS=Úkoly

# Docker containers to monitor (comma-separated, empty = all)
WATCHED_CONTAINERS=immich,jellyfin,radicale,pihole,seadrive,hugo,sonarr,radarr

# Display settings (Kindle Basic 10th gen landscape mode)
SCREEN_WIDTH=800
SCREEN_HEIGHT=600

# Rotate image in degrees (0, 90, 180, 270) to match Kindle hardware panel orientation
ROTATE_DEG=270

# Refresh interval in seconds (how often to re-fetch data)
REFRESH_INTERVAL=300

# Server port
PORT=5000
