# Kindle Dashboard Configuration

# Weather location (Tvarožná u Brna)
WEATHER_LAT=49.1847
WEATHER_LON=16.7064

# Radicale CalDAV server
RADICALE_URL=http://radicale:5232/user/
RADICALE_USER=user
RADICALE_PASS=password

# Docker containers to monitor (comma-separated, empty = all)
WATCHED_CONTAINERS=immich,jellyfin,radicale,pihole,seadrive,hugo,sonarr,radarr

# Display settings (Kindle Basic 10th gen)
SCREEN_WIDTH=600
SCREEN_HEIGHT=800

# Refresh interval in seconds (how often to re-fetch data)
REFRESH_INTERVAL=300

# Server port
PORT=5000
